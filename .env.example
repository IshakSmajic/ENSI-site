# Environment variables for the Plant Pharmacy website.
#
# Copy this file to `.env.local` and fill in real values:
#   cp .env.example .env.local
#
# Conventions:
# - `.env.local` holds real values and is ignored by Git. Never commit secrets.
# - This file is committed and must only ever contain placeholders.
# - Variables prefixed with `NEXT_PUBLIC_` are inlined into the browser bundle.
#   Only use that prefix for values that are safe to expose publicly.
# - Variables without the prefix are only available on the server.

# --- Supabase (required) ---
# Supabase Dashboard -> Project Settings -> API Keys / Data API.
#
# Project URL. Public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
#
# Publishable key (starts with `sb_publishable_`). Public: safe in the browser
# because access is controlled by Supabase Auth and Row Level Security.
# The legacy `anon` key also works here.
#
# NEVER put the secret key (`sb_secret_...`) or the legacy `service_role` key in
# this variable or in any other NEXT_PUBLIC_ variable. The application does not
# use a privileged key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
